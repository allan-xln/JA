"use client";

import { AlertsList } from "@/components/dashboard/alerts-list";
import { AssetsTable } from "@/components/dashboard/assets-table";
import { MetricsGrid } from "@/components/dashboard/metrics-grid";
import { TemperatureChart } from "@/components/dashboard/temperature-chart";
import { Header } from "@/components/layout/header";
import { Sidebar } from "@/components/layout/sidebar";
import { useDashboard } from "@/hooks/useDashboard";

export function DashboardShell() {
  const {
    metrics,
    assets,
    alerts,
    chartData,
    loading,
    error,
    lastUpdate,
    refresh,
  } = useDashboard(5000);

  return (
    <main className="min-h-screen bg-[linear-gradient(180deg,#0d1521_0%,#080d14_100%)] text-slate-50">
      <div className="grid min-h-screen lg:grid-cols-[280px_minmax(0,1fr)]">
        <Sidebar />

        <div className="flex min-h-screen flex-col">
          <Header />

          <section className="flex-1 px-4 py-5 md:px-6 lg:px-8">
            <div className="mx-auto flex w-full max-w-[1600px] flex-col gap-6">

              {/* HEADER DO DASHBOARD */}
              <div className="flex flex-col gap-4 rounded-3xl border border-white/10 bg-white/[0.04] p-5 shadow-2xl shadow-black/10 backdrop-blur-xl md:flex-row md:items-center md:justify-between">
                <div>
                  <p className="text-xs uppercase tracking-[0.22em] text-cyan-300">
                    Centro de comando
                  </p>
                  <h1 className="mt-2 text-2xl font-bold tracking-tight md:text-3xl">
                    Dashboard Eletrofrio
                  </h1>
                  <p className="mt-2 max-w-3xl text-sm leading-6 text-white/65">
                    Monitoramento operacional, análise de risco e visão em
                    tempo real dos sistemas de refrigeração.
                  </p>
                </div>

                <div className="flex flex-col gap-3 sm:flex-row sm:items-center">
                  <div className="rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-sm text-white/70">
                    Última atualização:{" "}
                    <span className="font-medium text-white">
                      {lastUpdate ?? "aguardando dados"}
                    </span>
                  </div>

                  <button
                    onClick={() => void refresh()}
                    className="rounded-2xl border border-cyan-400/20 bg-cyan-400/10 px-4 py-3 text-sm font-semibold text-cyan-200 transition hover:bg-cyan-400/15"
                  >
                    Atualizar
                  </button>
                </div>
              </div>

              {/* ERRO */}
              {error && (
                <div className="rounded-3xl border border-red-400/20 bg-red-400/10 p-5 text-red-200 shadow-2xl backdrop-blur-xl">
                  <p className="text-sm font-semibold">
                    Erro ao carregar dashboard
                  </p>
                  <p className="mt-2 text-sm text-red-100/80">{error}</p>
                </div>
              )}

              {/* MÉTRICAS */}
              <MetricsGrid metrics={metrics} />

              {/* LOADING */}
              {loading && metrics.length === 0 && (
                <div className="rounded-3xl border border-white/10 bg-white/[0.04] p-8 text-center text-sm text-white/60 shadow-2xl backdrop-blur-xl">
                  Carregando dados da API...
                </div>
              )}

              {/* GRÁFICO + ALERTAS */}
              <section className="grid gap-6 xl:grid-cols-[minmax(0,1.5fr)_420px]">
                <TemperatureChart data={chartData} />
                <AlertsList alerts={alerts} />
              </section>

              {/* TABELA */}
              <AssetsTable assets={assets} />
            </div>
          </section>
        </div>
      </div>
    </main>
  );
}
